<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>HazelRules</key>
	<array>
		<dict>
			<key>actions</key>
			<array>
				<dict>
					<key>action</key>
					<string>Move</string>
					<key>folder</key>
					<string>Trash</string>
				</dict>
			</array>
			<key>conditions</key>
			<array>
				<dict>
					<key>attribute</key>
					<string>Size</string>
					<key>operator</key>
					<string>less than</string>
					<key>value</key>
					<integer>1024</integer>
				</dict>
			</array>
			<key>enabled</key>
			<true/>
			<key>matchAllConditions</key>
			<true/>
			<key>name</key>
			<string>Supprimer fichiers vides</string>
		</dict>
		<dict>
			<key>actions</key>
			<array>
				<dict>
					<key>action</key>
					<string>Move</string>
					<key>folder</key>
					<string>Trash</string>
				</dict>
			</array>
			<key>conditions</key>
			<array>
				<dict>
					<key>attribute</key>
					<string>Name</string>
					<key>operator</key>
					<string>contains</string>
					<key>value</key>
					<string>.DS_Store</string>
				</dict>
			</array>
			<key>enabled</key>
			<true/>
			<key>matchAllConditions</key>
			<true/>
			<key>name</key>
			<string>Supprimer fichiers système inutiles</string>
		</dict>
		<dict>
			<key>actions</key>
			<array>
				<dict>
					<key>action</key>
					<string>Rename</string>
					<key>pattern</key>
					<string>%date created%-%kind%-[original name]</string>
				</dict>
			</array>
			<key>conditions</key>
			<array>
				<dict>
					<key>attribute</key>
					<string>Extension</string>
					<key>operator</key>
					<string>is</string>
					<key>value</key>
					<string>pdf</string>
				</dict>
			</array>
			<key>enabled</key>
			<true/>
			<key>matchAllConditions</key>
			<true/>
			<key>name</key>
			<string>Renommer – Ajout date + catégorie</string>
		</dict>
		<dict>
			<key>actions</key>
			<array>
				<dict>
					<key>action</key>
					<string>RunShellScript</string>
					<key>script</key>
					<string>/usr/local/bin/pandoc "$1" -o "${1%.*}.md"</string>
				</dict>
			</array>
			<key>conditions</key>
			<array>
